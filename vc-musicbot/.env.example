# ============================================================
# Telegram VC Music Userbot — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your actual .env file.
# ============================================================

# ---------- Telegram API (https://my.telegram.org) ----------
API_ID=
API_HASH=

# Bot account (created via @BotFather) — used for commands/UI
BOT_TOKEN=

# ---------- Assistant Accounts (the ones that join VC) ----------
# Comma-separated Pyrogram session strings. Add more as ASSISTANT_SESSION_2, _3, etc.
# Generate with: python scripts/generate_session.py
ASSISTANT_SESSION_1=
ASSISTANT_SESSION_2=
ASSISTANT_SESSION_3=

# ---------- Database ----------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=vc_musicbot

REDIS_URL=redis://default:<password>@<host>:<port>

# ---------- Owner / Admin ----------
OWNER_ID=
SUDO_USERS=  # comma-separated Telegram user IDs

# ---------- Spotify Web API (metadata only — no streaming) ----------
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------- Audio Source Config ----------
# Local file library root (for local file playback)
LOCAL_MUSIC_DIR=./music_library
# Max direct-URL stream size in MB (safety limit)
MAX_STREAM_SIZE_MB=500

# ---------- GitHub Actions Chaining (self-relay deployment) ----------
GITHUB_TOKEN=
GITHUB_REPOSITORY=  # e.g. yourname/vc-musicbot
# Minutes before the 6h job limit to trigger the next workflow
CHAIN_TRIGGER_BEFORE_MIN=15
# Minutes between watchdog health checks
WATCHDOG_INTERVAL_MIN=10

# ---------- Dashboard ----------
DASHBOARD_SECRET_KEY=change_this_to_a_random_64_char_string
DASHBOARD_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_TO_FILE=true

# ---------- Feature Flags ----------
ENABLE_AI_RECOMMENDATIONS=false
ENABLE_DASHBOARD=true
ENABLE_MULTI_ASSISTANT=true
MAX_QUEUE_SIZE=200
